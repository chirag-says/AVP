# Copy this file to .env and fill in real values. Never commit .env.

# Sarvam AI — https://dashboard.sarvam.ai. NOT free: ~Rs.100 trial credit on
# signup, then STT Rs.30/hour and TTS Rs.15/10K chars, billed per use.
SARVAM_API_KEY=

# Which provider runs each leg of the cascade.
#   STT_PROVIDER  sarvam | whisper   (default sarvam)
#   TTS_PROVIDER  sarvam | kokoro    (default sarvam)
#   LLM_PROVIDER  google | sarvam    (default google — see below)
# LLM_PROVIDER stays on google deliberately: sarvam-30b emitted zero save_field
# tool calls over a 5-turn intake and produced an empty record, where gemini
# saved 4/5. Prove it changed with smoke/test_sarvam_tools.py before flipping.
# To fall back to the fully-local speech stack: STT_PROVIDER=whisper TTS_PROVIDER=kokoro

# Google AI Studio key (free tier) — https://aistudio.google.com/apikey
# Required at the default LLM_PROVIDER=google.
GOOGLE_API_KEY=

# Supabase project — Settings > API in your Supabase dashboard
SUPABASE_URL=
# service_role key — server-only, never expose to the browser/React app
SUPABASE_SERVICE_KEY=

# --- Voice input (all optional; defaults are the A/B winners) ------------------
# Evidence and the live test procedure: server/voice_eval/TEST_PLAN.md
#
# Suppress barge-ins and transcripts caused by the bot's own voice leaking into
# the mic (browser echo cancellation misses). false = stock Pipecat behavior.
# ENABLE_TTS_ECHO_GUARD=true
# Headset kiosks ONLY: accept a transcript as patient speech only when local VAD
# also heard speech. Stops a bystander's words in the patient's pauses from
# entering the intake (measured: VAD never fires on a bystander ~1 m from a
# headset mic, Sarvam still transcribed them in 4/10 pauses). Never enable for
# laptop/desk mics: VAD hears the bystander there too, and soft patients would
# lose their fallback.
# HEADSET_MODE=false
# When the patient spoke but no transcript came back, the bot says "Sorry, I
# didn't catch that. Could you please repeat that?" (max 2 in a row) instead of
# going silent. Nothing is saved from the empty turn.
# STT_NO_TRANSCRIPT_RECOVERY=true
# Server log level. Pipecat's DEBUG output includes raw transcripts, the LLM
# context and save_field arguments (patient data); INFO has none of it.
# LOG_LEVEL=INFO
# Development test sessions only: enables per-role scoring against the
# tester's P/B key marks (open the page with ?scenario=<name>). See
# server/voice_eval/DEVICE_TEST_PROTOCOL.md. Leave unset in production.
# VOICE_DEBUG_SCENARIO=
# One content-free JSON line per session ("voice_telemetry ...") with mic
# levels, SNR, echo level, interruptions, STT latency. No audio, no text.
# VOICE_TELEMETRY=true
# Silero silence (s) before asking Smart Turn "is the patient done?".
# 0.2 measured fewer early cut-offs than the old 0.8 at the same latency.
# VAD_STOP_SECS=0.2
# Server-side denoiser before VAD/STT: none | rnnoise. rnnoise measured WORSE
# (and needs `pip install pyrnnoise`, not in requirements.txt).
# SERVER_DENOISER=none
# Sarvam STT. saaras:v4 (default) passed the final reliability gate and is far
# more accurate on phone numbers and drug names. saaras:v3 = previous default.
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_STT_LANGUAGE=en-IN      # hi-IN, kn-IN, ta-IN, ... or unknown (auto)
# SARVAM_STT_MODE=transcribe     # codemix keeps English words in English
# Sarvam server VAD: default (Sarvam's own) | permissive (the pre-fix tuning,
# which dropped soft-spoken patients).
# SARVAM_VAD_PROFILE=default
# Keyterm biasing (saaras:v4 only). EXPERIMENTAL, keep off: it rewrote unlisted
# drugs into listed look-alikes (7 wrong substitutions in 92 trials vs 0 without).
# See server/voice/vocabulary.json.
# STT_KEYTERMS=false
# STT_KEYTERM_LIMIT=50
# STT_VOCABULARY_EXTRA_FILE=
#
# Full rollback to the previous behavior (as of commit 31ac190 + the working
# tree before this change):
#   ENABLE_TTS_ECHO_GUARD=false  VOICE_TELEMETRY=false  VAD_STOP_SECS=0.8
#   SARVAM_VAD_PROFILE=permissive   (working-tree tuning; omit for HEAD's)
# and in web/.env.local: VITE_VOICE_AUDIO_PROCESSING=false
