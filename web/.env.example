# Copy to web/.env.local to override. All optional.

# Session bootstrap endpoints (defaults shown).
# VITE_START_ENDPOINT=http://localhost:7860/start
# VITE_SCRIBE_START_ENDPOINT=http://localhost:7861/start

# Browser mic processing, requested explicitly from daily-js (the library that
# opens the mic for Pipecat's SmallWebRTC transport). Browser echo cancellation
# is the only echo canceller in the system. The console logs what the browser
# actually applied ("[mic] processing in effect") and the server logs it too.
# VITE_VOICE_AUDIO_PROCESSING=true   # false = don't request anything (old behavior)
# VITE_MIC_ECHO_CANCELLATION=true
# VITE_MIC_NOISE_SUPPRESSION=true
# VITE_MIC_AUTO_GAIN_CONTROL=true    # per page load: ?agc=0 / ?agc=1 (also ?ec=, ?ns=)
# VITE_MIC_VOICE_ISOLATION=false     # experimental, per page load ?vi=1; see DEVICE_TEST_PROTOCOL.md
#
# Headset kiosks: set VITE_MIC_ECHO_CANCELLATION=false. Chrome's echo canceller
# attenuates the patient by 24-34 dB whenever the bot talks (measured, see
# server/voice_eval/chrome_aec_probe.py), which blocks talking over the bot.
# A headset has no speaker-to-mic echo to cancel. NEVER disable it with
# laptop/desk speakers.
